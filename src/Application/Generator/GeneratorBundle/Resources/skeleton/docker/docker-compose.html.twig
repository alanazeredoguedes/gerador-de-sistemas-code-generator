version: "3.7"

services:
  app:
    build:
      context: ./docker/php/
      dockerfile: Dockerfile
    image: app-php81
    container_name: app-{{ projectName }}
    restart: unless-stopped
    working_dir: /var/www/
    volumes:
      - ./:/var/www
    networks:
      - network-project


  nginx:
    image: nginx:1.17-alpine
    container_name: nginx-{{ projectName }}
    restart: unless-stopped
    ports:
      - "9000:80"
    volumes:
      - ./:/var/www
      - ./docker/nginx:/etc/nginx/conf.d
    networks:
      - network-project

networks:
  network-project:
    driver: bridge